{
  "name": "love2d-typescript",
  "version": "1.0.0",
  "main": "dist/index.js",
  "author": "Jake Klassen",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#app/*": "./dist/*"
  },
  "scripts": {
    "prebuild": "shx rm -rf game",
    "build": "shx rm -rf game && pnpm build:tstl && pnpm build:copy",
    "build:tstl": "tstl -p tsconfig.build.json",
    "build:copy": "shx cp -R res game",
    "build:watch": "tstl -w -p tsconfig.build.json",
    "pack:love": "pnpm build && node scripts/pack.ts",
    "lint": "oxlint --type-aware",
    "start": "love game --console",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "adm-zip": "^0.6.0",
    "comment-json": "5.0.0",
    "expect": "30.4.1",
    "love-typescript-definitions": "^11.5.3",
    "lua-types": "^2.14.1",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.2",
    "typescript-to-lua": "^1.37.1",
    "vitest": "^4.1.10"
  }
}
